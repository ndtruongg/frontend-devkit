{
  "name": "frontend-devkit",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first frontend developer utilities for Chrome.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.17.1",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "build": "wxt build -b chrome --mv3",
    "postinstall": "wxt prepare",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "wxt prepare && vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:headed": "pnpm build && playwright test --headed"
  },
  "dependencies": {
    "pinia": "4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "@wxt-dev/module-vue": "1.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "wxt": "0.21.5"
  }
}
